---
import type { ComponentProps } from 'astro/types'
import SharedExample from '@twbs/bui/components/Example'
import { getConfig } from '@libs/config'

type Props = ComponentProps<typeof SharedExample>

const config = getConfig()
---

<SharedExample {...Astro.props} repositoryUrl={config.repo} repositoryRef={`v${config.current_version}`}>
  <slot name="actions" slot="actions" />
</SharedExample>
