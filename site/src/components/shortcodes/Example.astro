---
import type { ComponentProps } from 'astro/types'
import SharedExample from '@twbs/bui/components/Example'
import { replacePlaceholdersInHtml } from '@twbs/bui/examples/placeholder'
import { getConfig } from '@libs/config'

type Props = ComponentProps<typeof SharedExample> & {
  /**
   * Shows the "Try it on StackBlitz" button. Turn it off for examples a
   * playground can't reproduce.
   * @default true
   */
  stackblitz?: boolean
}

// The button goes in the toolbar's `actions` slot, so `@twbs/bui` doesn't render
// its own: it only shows one on examples marked `addStackblitzJs`
const { addStackblitzJs = false, stackblitz = true, ...props } = Astro.props
const showStackblitz = stackblitz && props.showPreview !== false

// The playground starts from the example as written, not from its preview, which the plugins
// change once they start (a range's fill and ticks, an OTP input's slots…)
const sourceMarkup = showStackblitz
  ? replacePlaceholdersInHtml(Array.isArray(props.code) ? props.code.join('\n') : props.code)
  : ''

// Grid previews fill the example. Keep containers in the code and playground.
const isGridExample = props.class?.split(/\s+/).some((name) => name === 'bd-example-row' || name === 'bd-example-cols')
const previewCode = isGridExample
  ? (Array.isArray(props.code) ? props.code.join('\n') : props.code).replace(
      / class="([^"]*)"/g,
      (_match, classes: string) => {
        const names = classes.split(/\s+/).filter((name) => name !== 'container' && name !== 'container-fluid')
        return names.length ? ` class="${names.join(' ')}"` : ''
      }
    )
  : props.code
const displayedCode = props.customMarkup ?? (isGridExample ? props.code : undefined)

const config = getConfig()
---

<SharedExample
  {...props}
  code={previewCode}
  customMarkup={displayedCode}
  repositoryUrl={config.repo}
  repositoryRef={`v${config.current_version}`}
>
  <Fragment slot="actions">
    <slot name="actions" />
    {
      showStackblitz && (
        <>
          <button
            type="button"
            class="btn-edit text-nowrap"
            title="Try it on StackBlitz"
            data-sb-js-snippet={addStackblitzJs ? 'true' : undefined}
          >
            <svg class="bi" aria-hidden="true">
              <use href="#lightning-charge-fill" />
            </svg>
          </button>
          <template class="bd-example-source" set:html={sourceMarkup} />
        </>
      )
    }
  </Fragment>
</SharedExample>
